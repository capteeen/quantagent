{
  "name": "@quantagent/x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "quantagent X client: OAuth 2.0 PKCE on the user's own account, posting/threads/media/mentions/search/trends/profile, rate limiting, dead-letter queue, monthly call budget.",
  "exports": {
    ".": "./src/index.ts",
    "./oauth": "./src/oauth/index.ts",
