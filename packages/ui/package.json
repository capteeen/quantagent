{
  "name": "@quantagent/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "quantagent ui: design tokens, phone-first component kit, and THE CHAMBER (the 3D view of eight workers computing at once).",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./chamber": "./src/chamber/index.ts",
    "./kit": "./src/kit/index.ts",
    "./fixtures/launch.recorded.json": "./src/fixtures/launch.recorded.json",
    "./fonts.css": "./src/fonts.css"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "frametime": "tsx scripts/frametime.ts",
    "fixture": "tsx scripts/make-fixture.ts",
    "shot": "tsx scripts/shot.ts"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@quantagent/core": "workspace:*",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
