# quantagent — every environment variable the whole system reads, grouped by the package that reads it.
# Nothing here has a fake default: an unset variable surfaces in the app as NotImplemented naming it.
# Copy to apps/web/.env.local for `next dev`.

# ─────────────────────────────── apps/web ───────────────────────────────
LLM_PROVIDER=                      # anthropic | openai — which LlmClient adapter the orchestrator builds
ANTHROPIC_API_KEY=                 # Anthropic Messages API key (LLM_PROVIDER=anthropic)
ANTHROPIC_BASE_URL=                # optional; default https://api.anthropic.com
OPENAI_API_KEY=                    # OpenAI-compatible chat key (LLM_PROVIDER=openai); also the Artist's openai image key
OPENAI_BASE_URL=                   # optional; default https://api.openai.com/v1 (any OpenAI-compatible server)
LLM_API_KEY=                       # optional generic key, used when the provider-specific key above is unset
LLM_MODEL=                         # optional; default claude-sonnet-4-5 (anthropic) / gpt-4o-mini (openai)
SESSION_SECRET=                    # HMAC key for the qa_session cookie (falls back to X_TOKEN_KEY); `openssl rand -hex 32`
SOLANA_CLUSTER=                    # mainnet-beta (default, no flag needed) | devnet (wallet/watcher testing only; pump.fun has no devnet)
NEXT_PUBLIC_SOLANA_CLUSTER=        # the cluster the browser wallet adapter asks for; default mainnet-beta; keep equal to SOLANA_CLUSTER
LAUNCH_DEV_BUY_SOL=                # optional; dev buy folded into the pump.fun create, default 0.1 (workers DEFAULT_DEV_BUY_SOL)
TRADER_BUDGET_SOL=                 # optional; the Trader's SOL budget per launch, default 0.1 (core DEFAULT_BUDGETS)
NODE_ENV=                          # development | production | test; production marks cookies Secure and forbids pseudo quantum providers

# ─────────────────────────────── packages/core ───────────────────────────────
DATABASE_URL=                      # Postgres: event store (launch_events), X tokens (x_tokens), agent wallet keys; unset = in-memory
REDIS_URL=                         # Redis: event stream pub/sub + BullMQ post-launch queue; unset = in-process stream, post-launch NotImplemented

# ─────────────────────────────── packages/workers ───────────────────────────────
IMAGE_PROVIDER=                    # openai | fal | replicate — the Artist's image generator
OPENAI_IMAGE_MODEL=                # optional; default gpt-image-1
FAL_KEY=                           # fal.ai key (IMAGE_PROVIDER=fal)
FAL_MODEL=                         # optional; default fal-ai/flux/dev
REPLICATE_API_TOKEN=               # Replicate token (IMAGE_PROVIDER=replicate)
REPLICATE_MODEL=                   # optional; default black-forest-labs/flux-schnell
S3_ENDPOINT=                       # S3-compatible endpoint for generated images (R2 / MinIO / AWS)
S3_BUCKET=                         # bucket name
S3_ACCESS_KEY=                     # access key id
S3_SECRET_KEY=                     # secret access key
S3_PUBLIC_URL=                     # public base URL the bucket is served from
S3_REGION=                         # optional; default auto
HOSTING_PROVIDER=                  # cloudflare | vercel — the Builder's site host
CF_API_TOKEN=                      # Cloudflare API token with Pages:Edit
CF_ACCOUNT_ID=                     # Cloudflare account id
CF_PAGES_PROJECT=                  # Pages project name prefix (<prefix>-<slug>)
VERCEL_TOKEN=                      # Vercel access token
VERCEL_PROJECT=                    # Vercel project name prefix (<prefix>-<slug>)
VERCEL_TEAM_ID=                    # optional Vercel team id
SITE_DOMAIN=                       # optional; sites get <slug>.<SITE_DOMAIN>
VOICE_MAX_REPLIES_PER_TICK=        # optional; replies the Voice sends per tick
VOICE_IMAGE_EVERY_MS=              # optional; minimum interval between Voice image posts
DIP_PCT=                           # optional; dip depth (%) that lets the Trader buy
SLIPPAGE_BPS=                      # optional; slippage for Trader swaps
TRADER_BUY_SOL=                    # optional; SOL per Trader dip buy
TRADER_MIN_BUY_INTERVAL_MS=        # optional; minimum time between Trader buys
TRADER_SELL_LOCK_MS=               # optional; no sells for this long after launch
TRADER_TRAILING_WINDOW_MS=         # optional; trailing window the Trader measures dips over
TRADER_PRICE_FEED_URL=             # optional; price feed the Trader polls
RECRUITER_HOURLY_CAP=              # optional; outreach messages per hour
QSD_REPO_PATH=                     # optional; local checkout of qsd-market for the Launcher's QSD sequence

# ─────────────────────────────── packages/x ───────────────────────────────
X_CLIENT_ID=                       # OAuth 2.0 client id of the X app
X_CLIENT_SECRET=                   # only for a confidential app; public PKCE apps omit it
X_REDIRECT_URI=                    # byte-identical to the developer portal, e.g. https://<host>/api/x/oauth/callback
X_TOKEN_KEY=                       # 32-byte hex key for AES-256-GCM token encryption at rest; `openssl rand -hex 32`
X_TOKEN_STORE=                     # memory — dev/test only in-memory token store (otherwise DATABASE_URL is required)
X_MONTHLY_CALL_BUDGET=             # optional; monthly ceiling on X API calls, default 1500
X_TREND_QUERY=                     # optional; recent-search query for the trends fallback
X_OAUTH1_CONSUMER_KEY=             # optional OAuth 1.0a credentials for the two v1.1 profile endpoints
X_OAUTH1_CONSUMER_SECRET=          # (must belong to the connected account)
X_OAUTH1_ACCESS_TOKEN=             #
X_OAUTH1_ACCESS_TOKEN_SECRET=      #

# ─────────────────────────────── packages/solana ───────────────────────────────
AGENT_WALLET_KEY=                  # required for launches; 64 hex chars, AES-256-GCM key for agent wallet secret keys at rest
SOLANA_RPC_URL=                    # RPC endpoint; default public mainnet-beta RPC, or Helius mainnet when HELIUS_API_KEY is set (use a paid RPC in production)
HELIUS_API_KEY=                    # optional; Helius RPC, DAS holder counts and webhooks
HELIUS_WEBHOOK_URL=                # public URL Helius posts to: https://<host>/api/helius/webhook
HELIUS_WEBHOOK_SECRET=             # sent by Helius as Authorization; compared in constant time
HELIUS_WEBHOOK_API=                # optional override of https://api.helius.xyz/v0/webhooks
ANU_QRNG_API_KEY=                  # ANU Quantum Numbers API key; without it collapses fall back to the user's pick
ANU_QRNG_API_URL=                  # optional override of https://api.quantumnumbers.anu.edu.au/
PUMPPORTAL_URL=                    # optional override of https://pumpportal.fun/api/trade-local (a devnet-capable endpoint is the only way pump.fun calls work on devnet)
PUMPPORTAL_PRIORITY_FEE_SOL=       # optional; priority fee per tx, default 0.0005
PUMPPORTAL_POOL=                   # optional; pool for buy/sell, default pump
PINATA_JWT=                        # metadata/image host for token creation
PINATA_GATEWAY=                    # Pinata gateway host
PUMPFUN_IPFS_URL=                  # optional; opt into the legacy pump.fun IPFS multipart upload
PUMPFUN_API_URL=                   # optional; frontend API base, default https://frontend-api-v3.pump.fun
PUMPFUN_API_JWT=                   # optional bearer for the frontend API
COPYCAT_RECENT_COINS=              # optional; coins hashed per logo search, default 200
ANOMALY_POLL_MS=                   # optional; anomaly polling interval without webhooks, default 15000
BUNDLE_MIN_BUYS=                   # optional; default 3
BUNDLE_SLOT_WINDOW=                # optional; default 0
DEV_SELL_WINDOW_MIN=               # optional; default 30
MILESTONE_MCAP_USD=                # optional; default 10000,50000,100000,1000000
MILESTONE_HOLDERS=                 # optional; default 100,500,1000
MILESTONE_POLL_MS=                 # optional; default 30000

# ─────────────────────────────── packages/ui ───────────────────────────────
# (reads nothing from the environment)

# ─────────────────────────────── tests ───────────────────────────────
PLAYWRIGHT_BROWSERS_PATH=          # optional; where Playwright's Chromium lives, default /opt/pw-browsers
SKIP_E2E=                          # 1 skips the Playwright smoke test in `pnpm test`
E2E_PORT=                          # optional; port the smoke test's `next dev` listens on, default 3977
